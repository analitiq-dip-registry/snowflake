{
  "$schema": "https://schemas.analitiq.ai/connector/latest.json",
  "kind": "database",
  "connector_id": "snowflake",
  "display_name": "Snowflake",
  "description": "Snowflake cloud data warehouse connector built on the native ADBC Snowflake driver. Reads compile to paged SELECTs and stream back as Arrow; writes run the stage-then-MERGE primitive, landing each batch through the driver's own bulk ingest (Arrow -> Parquet -> PUT to a temporary internal stage -> COPY INTO) and applying it to the target with MERGE / INSERT ... SELECT. Authenticates with a Snowflake username and password over HTTPS on port 443.",
  "documentation_url": "https://docs.snowflake.com/",
  "tags": [
    "database",
    "warehouse",
    "snowflake",
    "adbc",
    "olap"
  ],
  "version": "0.3.0",
  "default_transport": "database",
  "transports": {
    "database": {
      "transport_type": "adbc",
      "driver": "snowflake",
      "db_kwargs": {
        "adbc.snowflake.sql.account": {
          "ref": "connection.parameters.account"
        },
        "username": {
          "ref": "connection.parameters.username"
        },
        "password": {
          "ref": "secrets.password"
        },
        "adbc.snowflake.sql.warehouse": {
          "ref": "connection.parameters.warehouse"
        },
        "adbc.snowflake.sql.db": {
          "ref": "connection.parameters.database"
        },
        "adbc.snowflake.sql.schema": {
          "ref": "connection.parameters.schema"
        },
        "adbc.snowflake.sql.role": {
          "ref": "connection.parameters.role"
        },
        "adbc.snowflake.sql.uri.protocol": "https",
        "adbc.snowflake.sql.uri.host": {
          "ref": "connection.parameters.host"
        },
        "adbc.snowflake.sql.uri.port": {
          "ref": "connection.parameters.port"
        },
        "adbc.snowflake.sql.auth_type": "auth_snowflake"
      }
    }
  },
  "auth": {
    "type": "db"
  },
  "connection_contract": {
    "inputs": {
      "account": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": true,
        "ui": {
          "label": "Account identifier",
          "placeholder": "orgname-account_name",
          "widget": "text",
          "help_text": "Snowflake account identifier without the .snowflakecomputing.com suffix."
        }
      },
      "warehouse": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": false,
        "ui": {
          "label": "Warehouse",
          "placeholder": "COMPUTE_WH",
          "widget": "text",
          "help_text": "Virtual warehouse that executes queries. Leave blank only if the user has a default warehouse; without one, every query fails."
        }
      },
      "database": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": false,
        "ui": {
          "label": "Database",
          "widget": "text",
          "help_text": "Database selected for the session. Required for writes: each batch is staged in a session-scoped temporary table that resolves against the session's current database and schema."
        }
      },
      "schema": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": false,
        "default": "PUBLIC",
        "ui": {
          "label": "Schema",
          "placeholder": "PUBLIC",
          "widget": "text",
          "help_text": "Schema selected for the session. Required for writes: batch staging resolves against it. The connecting role needs CREATE STAGE on this schema - the ADBC bulk-ingest path creates a temporary internal stage there."
        }
      },
      "role": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": false,
        "ui": {
          "label": "Role",
          "widget": "text",
          "help_text": "Authorization role. Defaults to the user's default role; object visibility and write privileges are scoped to it."
        }
      },
      "host": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": false,
        "ui": {
          "label": "Host override",
          "placeholder": "<account>.snowflakecomputing.com",
          "widget": "text",
          "help_text": "Explicit host. Normally derived from the account identifier; set only for private-link or non-standard endpoints."
        }
      },
      "port": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "integer",
        "required": false,
        "default": 443,
        "ui": {
          "label": "Port",
          "widget": "number",
          "help_text": "Snowflake serves all client traffic on 443 over HTTPS."
        }
      },
      "username": {
        "source": "user",
        "phase": "auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": true,
        "ui": {
          "label": "Username",
          "widget": "text"
        }
      },
      "password": {
        "source": "user",
        "phase": "auth",
        "storage": "secrets",
        "type": "string",
        "required": true,
        "secret": true,
        "ui": {
          "label": "Password",
          "widget": "password"
        }
      }
    }
  },
  "sql_capabilities": {
    "catalog": "full",
    "session_targeting": "session_default",
    "merge_form": "merge",
    "bulk_load": {
      "adbc": "adbc_ingest"
    },
    "stage": {
      "scope": "temp",
      "schema": "target",
      "transactional_ddl": false
    },
    "limits": {
      "max_identifier_len": 255
    }
  },
  "resource_discovery": {
    "strategy": "snowflake_account_usage",
    "transport_ref": "database",
    "implementation": {
      "type": "builtin"
    },
    "produces": [
      "connection.endpoints",
      "connection.type_map"
    ],
    "triggers": {
      "list_resources": "on_activation",
      "describe_resource": "on_resource_selected"
    }
  }
}
