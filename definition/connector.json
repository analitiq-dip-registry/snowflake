{
  "$schema": "https://schemas.analitiq.ai/connector/latest.json",
  "kind": "database",
  "connector_id": "snowflake",
  "display_name": "Snowflake",
  "description": "Snowflake cloud data warehouse connector using the native ADBC Snowflake driver with standard username and password authentication over TLS.",
  "tags": ["database", "warehouse", "snowflake", "adbc", "olap"],
  "version": "0.1.0",
  "default_transport": "database",
  "transports": {
    "database": {
      "transport_type": "adbc",
      "driver": "snowflake",
      "db_kwargs": {
        "adbc.snowflake.sql.account": { "ref": "connection.parameters.account" },
        "username": { "ref": "connection.parameters.username" },
        "password": { "ref": "secrets.password" },
        "adbc.snowflake.sql.warehouse": { "ref": "connection.parameters.warehouse" },
        "adbc.snowflake.sql.db": { "ref": "connection.parameters.database" },
        "adbc.snowflake.sql.schema": { "ref": "connection.parameters.schema" },
        "adbc.snowflake.sql.role": { "ref": "connection.parameters.role" },
        "adbc.snowflake.sql.uri.host": { "ref": "connection.parameters.host" },
        "adbc.snowflake.sql.uri.port": { "ref": "connection.parameters.port" },
        "adbc.snowflake.sql.auth_type": "auth_snowflake"
      }
    }
  },
  "auth": { "type": "db" },
  "connection_contract": {
    "inputs": {
      "account": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": true,
        "ui": { "label": "Account identifier", "placeholder": "orgname-account_name", "widget": "text" }
      },
      "warehouse": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": false,
        "ui": { "label": "Warehouse", "placeholder": "COMPUTE_WH", "widget": "text" }
      },
      "database": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": false,
        "ui": { "label": "Database", "widget": "text" }
      },
      "schema": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": false,
        "default": "PUBLIC",
        "ui": { "label": "Schema", "placeholder": "PUBLIC", "widget": "text" }
      },
      "role": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": false,
        "ui": { "label": "Role", "widget": "text" }
      },
      "host": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": false,
        "ui": { "label": "Host override", "placeholder": "<account>.snowflakecomputing.com", "widget": "text" }
      },
      "port": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "integer",
        "required": false,
        "default": 443,
        "ui": { "label": "Port", "widget": "number" }
      },
      "username": {
        "source": "user",
        "phase": "auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": true,
        "ui": { "label": "Username", "widget": "text" }
      },
      "password": {
        "source": "user",
        "phase": "auth",
        "storage": "secrets",
        "type": "string",
        "required": true,
        "secret": true,
        "ui": { "label": "Password", "widget": "password" }
      }
    }
  },
  "resource_discovery": {
    "strategy": "snowflake_account_usage",
    "transport_ref": "database",
    "implementation": { "type": "builtin" },
    "produces": ["connection.endpoints", "connection.type_map"],
    "triggers": {
      "list_resources": "on_activation",
      "describe_resource": "on_resource_selected"
    }
  }
}
